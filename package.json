{
  "name": "mithas-glow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "frontend": "vite --host",
    "frontend:https": "vite --host",
    "build": "vite build",
    "backend": "uvicorn backend.main:app --reload",
    "dev": "concurrently \"npm run frontend:https\" \"npm run backend\"",
    "dev:http": "concurrently \"npm run frontend\" \"npm run backend\"",
    "setup-https": "mkcert localhost 127.0.0.1 ::1 && mv localhost+2.pem ./localhost.pem && mv localhost+2-key.pem ./localhost-key.pem",
    "tunnel": "ngrok http 5173",
    "tunnel:cloudflare": "cloudflared tunnel --url http://localhost:5173"
  },
