```gitignore
# Dependencies
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/

# Build outputs
dist/
build/
.out/
.bundle/

# TypeScript/JavaScript
*.tsbuildinfo
*.js.map
*.jsx.map
*.ts.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.*
!.env.example

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Python (if applicable)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/modules/
*.tmproj
# These are for files which would otherwise be tracked by
# git status clean
!*.crt
!*.pem
!*.key
!*.pub
!*.zip
!*.tar.gz
!*.deb
!*.rpm
!*.jar
