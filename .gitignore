```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
out/

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
.coverage

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Temporary files
*.tmp
*.temp
*.bak

# MyPy cache
.mypy_cache/
.pytest_cache/

# Distribution / packaging
*.tar.gz
*.whl
*.egg

# Local configuration
.env.test
.env.production
.env.development
```