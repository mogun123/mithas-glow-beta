*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-selfcheck.json
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
.git/
.mypy_cache/
.pytest_cache/
.hypothesis/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
dist/
logs
*.log
npm-shrinkwrap.json
.nyc_output
coverage
.nyc_output/
coverage/
lib-cov
*.seed
*.pid
*.gz
*.zip
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
