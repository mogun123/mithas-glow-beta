```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# Logs
*.log

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# Python related (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage.xml
*.gcda
*.gcno

# Bundler
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
ehthumbs.db
Icon?
apidoc/
```