dist/
build/
*.js.map
*.ts.map
*.jsx.map
*.tsx.map

# Logs
*.log

# Environment variables
.env
.env.local
*.env

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage
htmlcov/
coverage.xml
.pytest_cache/
.mypy_cache/
.tox/
.venv/
venv/
env/

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
node_modules/
jspm_packages/
*.npm
.npm
.nyc_output
coverage/
.nyc_output/

# TypeScript
*.tsbuildinfo
dist/
build/

# General build artifacts
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
*.class

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
