```gitignore
# Dependencies
node_modules/
.jest/
.nyc_output/
coverage/
.npm/
.yarn/

# Build outputs
dist/
build/
.next/
out/
public/build/
*.bundle.js
*.min.js
*.css.map

# Environment variables
.env
.env.local
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temporary files
*.tmp
*.temp
.DS_Store?
```
