pip-log.txt
pip-delete-this-directory.txt
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.log
*.tmp

# Compiled and binary files
*.class
*.o
*.so
*.a
*.dll
*.exe
*.out
*.swp
*.swo

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS specific
.DS_Store
Thumbs.db

# Testing
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/
```